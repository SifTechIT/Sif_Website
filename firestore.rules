rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
     // Your existing catch-all rule
    match /{document=**} {
      allow read, write: if request.auth.token.email.matches("firebase@flutterflow.io");
    }

    // Your existing time-based rule
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2025, 12, 30);
    }
    
 
    // WhatsApp Clone chat and message rules
match /chats/{chatId} {
  allow read, write: if request.auth != null;
  match /messages/{messageId} {
    allow read, write: if request.auth != null;
  }
}

 match /generateArticleKey/{docId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.allowedUsers;
      allow write: if false; 
    }


    match /categories/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /featureRequests/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /courses/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /bugs/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /paymentRecord/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /music/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /users/{document} {
      allow create: if request.auth.uid == document;
      allow read: if request.auth.uid == document;
      allow write: if request.auth.uid == document;
      allow delete: if request.auth.uid == document;
    }

    // ADD THESE NEW CERTIFICATE RULES
    match /certificatesCourses/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /certificatesParticipants/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /certificatesEditors/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /certificatesGenerated/{document} {
      allow create: if true;
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }
 // 🌍 Allow all access to everything else
    match /{collection}/{docId} {
      allow read, write: if true;
    }

  }
}